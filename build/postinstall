#!/bin/bash

# PrintPDF postinstall
# Based on RWTS PDFwriter 3.1 by Rodney I. Yager.

set -e

ln -sf /Library/Printers/PrintPDF/pdfwriter /usr/libexec/cups/backend/printpdf

chgrp admin /Library/Printers/PrintPDF/uninstall
chmod 750 /Library/Printers/PrintPDF/uninstall

launchctl unload /System/Library/LaunchDaemons/org.cups.cupsd.plist >/dev/null 2>&1 || true
launchctl load /System/Library/LaunchDaemons/org.cups.cupsd.plist >/dev/null 2>&1 || true

lpadmin -x PrintPDF >/dev/null 2>&1 || true
lpadmin -p PrintPDF -E -v printpdf:/ \
    -P /Library/Printers/PPDs/Contents/Resources/PrintPDF.gz \
    -o printer-is-shared=false

CONSOLE_USER="$(stat -f '%Su' /dev/console)"
if [ -n "$CONSOLE_USER" ] && [ "$CONSOLE_USER" != "root" ] && [ "$CONSOLE_USER" != "loginwindow" ]; then
    CONSOLE_UID="$(id -u "$CONSOLE_USER")"
    USER_HOME="$(dscl . -read "/Users/$CONSOLE_USER" NFSHomeDirectory 2>/dev/null | awk '{print $2}')"
    [ -n "$USER_HOME" ] || USER_HOME="/Users/$CONSOLE_USER"

    AGENT_DIR="$USER_HOME/Library/LaunchAgents"
    AGENT_PATH="$AGENT_DIR/com.printpdf.mover.plist"
    HEALTH_AGENT_PATH="$AGENT_DIR/com.printpdf.health.plist"
    SPOOL_DIR="/private/var/spool/printpdf/$CONSOLE_USER"

    mkdir -p "$AGENT_DIR" "$SPOOL_DIR"
    chown "$CONSOLE_USER":staff "$AGENT_DIR" "$SPOOL_DIR"

    cat > "$AGENT_PATH" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.printpdf.mover</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Library/Printers/PrintPDF/pdfwriter-mover.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>WatchPaths</key>
    <array>
        <string>$SPOOL_DIR</string>
    </array>
    <key>StartInterval</key>
    <integer>5</integer>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
EOF

    cat > "$HEALTH_AGENT_PATH" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.printpdf.health</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Library/Printers/PrintPDF/printpdf-health-monitor.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>30</integer>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
EOF

    chown "$CONSOLE_USER":staff "$AGENT_PATH" "$HEALTH_AGENT_PATH"
    chmod 644 "$AGENT_PATH" "$HEALTH_AGENT_PATH"

    # Loading the mover agent is what makes delivery work at all. Report a
    # failure instead of hiding it, because a mover that is not loaded cannot
    # deliver PDFs and cannot raise its own alert.
    load_agent() {
        local label="$1"
        local path="$2"
        local domain="gui/$CONSOLE_UID"
        local attempt

        launchctl bootout "$domain" "$path" >/dev/null 2>&1 || true

        for attempt in 1 2 3; do
            launchctl bootstrap "$domain" "$path" >/dev/null 2>&1 && break
            # launchd can refuse the first attempt while the login session is
            # still starting up, so retry a few times before giving up.
            sleep 2
        done

        launchctl print "$domain/$label" >/dev/null 2>&1
    }

    FAILED_HELPERS=""
    load_agent "com.printpdf.mover" "$AGENT_PATH" || FAILED_HELPERS="com.printpdf.mover"
    load_agent "com.printpdf.health" "$HEALTH_AGENT_PATH" \
        || FAILED_HELPERS="${FAILED_HELPERS:+$FAILED_HELPERS, }com.printpdf.health"

    if [ -n "$FAILED_HELPERS" ]; then
        echo "PrintPDF: could not start background helper(s): $FAILED_HELPERS" >&2
        echo "PrintPDF: PDFs are not delivered until com.printpdf.mover is running." >&2
        printf '%s\n' \
            "PrintPDF could not start the following background helper(s): $FAILED_HELPERS" \
            "Printed PDFs stay in the spool folder until com.printpdf.mover runs." \
            "Open PrintPDF Utility and choose the destination folder again, or reinstall PrintPDF." \
            > "$USER_HOME/Library/Application Support/PrintPDF/install-warning.txt" 2>/dev/null || true
        launchctl asuser "$CONSOLE_UID" sudo -u "$CONSOLE_USER" /usr/bin/osascript \
            -e 'display notification "The background helper that delivers PDFs could not be started. Open PrintPDF Utility and choose your folder again, or reinstall PrintPDF." with title "PrintPDF problem"' \
            >/dev/null 2>&1 || true
    fi

    if [ "$COMMAND_LINE_INSTALL" != "1" ]; then
        launchctl asuser "$CONSOLE_UID" sudo -u "$CONSOLE_USER" \
            open "/Library/Printers/PrintPDF/Utilities/PrintPDF Utility.app" || true
    fi
fi
